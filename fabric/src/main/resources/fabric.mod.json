{
  "schemaVersion": 1,
  "id": "muffins_ovenapi",
  "version": "${version}",
  "name": "Muffin's Oven API",
  "description": "A library mod for FireMuffin303's Mods.",
  "authors": [
    "FireMuffin303"
  ],
  "contact": {
    "homepage": "https://github.com/FireMuffin303/MuffinsOvenAPI",
    "issues": "https://github.com/FireMuffin303/MuffinsOvenAPI/issues"
  },
  "license": "GPL-3.0",
  "icon": "assets/muffins_ovenapi/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.firemuffin303.muffinsmcapi.fabric.MuffinsmcapiFabric"
    ],
    "client": [
      "net.firemuffin303.muffinsmcapi.fabric.client.MuffinsmcapiFabricClient"
    ],
    "jei_mod_plugin": [
      "net.firemuffin303.muffinsmcapi.impl.customEffect.integrations.CommonJEIPlugin"
    ]
  },
  "mixins": [
    "muffinsmcapi.mixins.json",
    "muffinsmcapi.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~${minecraft_version}",
    "java": ">=17",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}
